# Database Configuration
# PostgreSQL format: postgresql+psycopg2://username:password@localhost:5432/job_market_db
# If not specified or PostgreSQL is unavailable, automatically falls back to sqlite:///job_market.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/job_market_db
DATABASE_FALLBACK_SQLITE=True
SQLITE_DB_PATH=job_market.db

# Crawler Politeness & Frontier Engine Settings
DEFAULT_USER_AGENT=JobDemandBot/1.0 (+https://github.com/job-intelligence/crawler; polite job market intelligence researcher)
DEFAULT_DOWNLOAD_DELAY_SECONDS=2.0
MAX_DOWNLOAD_DELAY_SECONDS=10.0
MAX_CONCURRENT_REQUESTS_PER_DOMAIN=1
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
OBEY_ROBOTS_TXT=True
STORE_RAW_HTML=True
MAX_CRAWL_PAGES_DEFAULT=20

# API & Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
DEBUG_MODE=True

# NLP & Skill Extraction Settings
SKILL_EXTRACTION_CONFIDENCE_THRESHOLD=0.75
MAX_EXTRACTED_SKILLS_PER_JOB=35
